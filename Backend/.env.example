NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:8081

# Optional. Without this key, OpenStreetMap, Wikidata and Wikimedia Commons still work.
# Foursquare enrichment is only requested when this key exists and is capped at 15 requests/day per backend process.
FOURSQUARE_API_KEY=

# Google Places Enterprise enrichment is OFF by default. Set to true only after enabling billing/API access.
# Enterprise fields (rating, review count, website, opening hours, phone, price level) may incur Google charges.
GOOGLE_PLACES_ENTERPRISE_MODE=false
GOOGLE_PLACES_API_KEY=

# Maximum restaurants enriched per /nearby or /search request (0-10; default 5).
# Each restaurant may trigger one Google Text Search request.
GOOGLE_PLACES_ENRICHMENT_MAX_RESULTS=5
